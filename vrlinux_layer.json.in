{
  "file_format_version": "1.2.0",
  "layer": {
    "name": "VK_LAYER_VRLINUX_vr",
    "type": "GLOBAL",
    "library_path": "@LIB@",
    "api_version": "1.3.275",
    "implementation_version": "1",
    "description": "vrlinux: flat Vulkan/Proton games in VR with head tracking (OpenXR: WiVRn/SteamVR)",
    "functions": {
      "vkGetInstanceProcAddr": "vrlinux_GetInstanceProcAddr",
      "vkGetDeviceProcAddr": "vrlinux_GetDeviceProcAddr",
      "vkNegotiateLoaderLayerInterfaceVersion": "vrlinux_NegotiateLoaderLayerInterfaceVersion"
    },
    "enable_environment": { "ENABLE_VRLINUX": "1" },
    "disable_environment": { "DISABLE_VRLINUX": "1" }
  }
}
